{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "activity-span",
  "type": "object",
  "required": ["span_id", "category", "started_at", "finished_at", "source"],
  "properties": {
    "span_id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "enum": ["test", "review", "admin"]},
    "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "finished_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "source": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
