{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "test-wave",
  "type": "object",
  "required": [
    "wave_id",
    "purpose",
    "stage",
    "command",
    "started_at",
    "finished_at",
    "result",
    "tests",
    "tested_sha",
    "green_sha",
    "shipping_ref",
    "flows",
    "shipped_flows",
    "screenshots"
  ],
  "properties": {
    "wave_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "enum": ["component", "integrated", "full-wave", "release"]},
    "stage": {"type": "string", "enum": ["verify"]},
    "command": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "finished_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "result": {"type": "string", "enum": ["passed", "failed", "aborted"]},
    "tests": {
      "type": "object",
      "required": ["passed", "failed", "skipped"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "tested_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "green_sha": {},
    "shipping_ref": {},
    "flows": {
      "type": "array",
      "items": {"type": "string", "pattern": "^J-[0-9]{3}:S[0-9]+$"}
    },
    "shipped_flows": {
      "type": "array",
      "items": {"type": "string", "pattern": "^J-[0-9]{3}:S[0-9]+$"}
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "flow", "state"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "flow": {"type": "string", "pattern": "^J-[0-9]{3}:S[0-9]+$"},
          "state": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
